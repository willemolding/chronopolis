# Force the vc4 KMS stack built-in rather than modular.
#
# bcmrpi_defconfig builds these as modules, which then have to be loaded in the
# right order before X starts. Built-in, the DRM device exists by the time
# userspace runs and there is no boot-order race to lose.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y

# The pool the decoded clock face textures are allocated from. Must be at least
# as large as the cma= argument in config.txt, which is what actually sizes it.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=192

# Input, for the arrow keys that switch between clock faces.
CONFIG_INPUT_EVDEV=y

# The PCF8523 real-time clock, and the I2C controller it hangs off, built-in.
#
# bcmrpi_defconfig builds both as modules. Built-in, the kernel sets the system
# time from rtc0 itself as the RTC registers (RTC_HCTOSYS), before userspace
# starts, so the clock's first frame already shows the right time. If no RTC is
# fitted, or its oscillator has stopped and the time is flagged invalid, the
# kernel leaves the system time alone.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8523=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
