# /etc/inittab — Chronopolis appliance
#
# Replaces Buildroot's stock BusyBox inittab. Two deliberate differences:
#
#  - No `mount -o remount,rw /`. The rootfs stays read-only; an installation
#    that gets unplugged rather than shut down should not be able to corrupt
#    its own filesystem.
#  - No getty on tty1. X owns that VT.
#
# Format: <id>:<runlevels>:<action>:<process>
# runlevels are ignored by BusyBox init.

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The installation itself. respawn, so a crash or a GL hiccup brings the clock
# back in a couple of seconds rather than leaving a black screen in a gallery.
::respawn:/usr/share/chronopolis/start.sh

# Serial console on the UART pins. With no networking in the image, this is the
# only way into a running system.
ttyAMA0::respawn:/sbin/getty -L ttyAMA0 115200 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
